# --- Development ---
# Optional: force API URL in dev (required on physical devices — use your LAN IP).
# iOS Simulator default: http://localhost:3001
# Android Emulator default: http://10.0.2.2:3001
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3001

# API port when using platform defaults (default 3001)
# EXPO_PUBLIC_API_PORT=3001

# --- Production / EAS builds ---
# Set in eas.json "env" for preview/production builds (recommended).
# EXPO_PUBLIC_API_URL=https://crm-production-6cfe.up.railway.app

# Privacy policy shown in Profile / store listing
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.ninjamarketing.in/privacy

# --- EAS (also set in app.config.ts after `eas init`) ---
# EXPO_OWNER=propninjacrm
# EAS_PROJECT_ID=fe2ff218-2069-40bb-ab90-e694a50777e2
