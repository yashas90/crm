{
  "name": "@propninja/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome check .",
    "test": "jest --ci",
    "test:maestro": "maestro test .maestro",
    "eas:login": "pnpm dlx eas-cli login",
    "eas:init": "pnpm dlx eas-cli init",
    "eas:build:android": "pnpm dlx eas-cli build --platform android --profile production",
    "eas:build:ios": "pnpm dlx eas-cli build --platform ios --profile production",
    "eas:build:preview:android": "pnpm dlx eas-cli build --platform android --profile preview",
    "android:prebuild": "pnpm exec expo prebuild --platform android --no-install && node scripts/patch-android-for-monorepo.mjs",
    "android:assemble:debug": "node scripts/patch-android-for-monorepo.mjs && node scripts/run-android-assemble.mjs debug",
    "android:apk:local": "pnpm android:prebuild && pnpm android:assemble:debug",
    "android:assemble:release": "node scripts/patch-android-for-monorepo.mjs && node scripts/run-android-assemble.mjs release",
    "eas:submit:android": "pnpm dlx eas-cli submit --platform android --profile production --latest",
    "eas:submit:ios": "pnpm dlx eas-cli submit --platform ios --profile production --latest",
    "eas-build-pre-install": "corepack enable"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@propninja/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/native-stack": "^7.3.14",
    "@tanstack/react-query": "^5.80.7",
    "expo": "~53.0.11",
    "expo-av": "~15.1.4",
    "expo-calendar": "~14.1.4",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.6",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "^0.31.5",
    "expo-screen-capture": "~7.2.0",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.15.5",
    "use-sync-external-store": "1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@propninja/config": "workspace:*",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.14",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.9",
    "typescript": "^5.8.3"
  }
}
