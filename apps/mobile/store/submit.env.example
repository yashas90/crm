# Copy to submit.env (gitignored) and fill before `eas submit`.
# Or pass credentials interactively on first submit.

# --- Expo / EAS ---
# EXPO_OWNER=your-expo-username-or-org
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Google Play (Android) ---
# Path to service account JSON from Play Console → API access
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./store/google-service-account.json

# --- App Store Connect (iOS) ---
# ASC_API_KEY_PATH=./store/asc-api-key.p8
# ASC_API_KEY_ID=XXXXXXXXXX
# ASC_API_KEY_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_APP_ID=1234567890
# APPLE_TEAM_ID=XXXXXXXXXX
