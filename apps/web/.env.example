# SENTRY_DSN_WEB=https://examplePublicKey@o0.ingest.sentry.io/0
# Exposed to the browser at build time as NEXT_PUBLIC_SENTRY_DSN_WEB
# Optional — upload source maps during Vercel build (requires Sentry auth token)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=propninja-web
