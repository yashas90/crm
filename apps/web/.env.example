NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional — direct APK download link shown on /download (Expo artifact, Drive, S3, etc.)
# NEXT_PUBLIC_MOBILE_APK_URL=https://example.com/propninja-1.0.7.apk
# Optional — Sentry error tracking (leave unset to disable locally)
# SENTRY_DSN_WEB=https://examplePublicKey@o0.ingest.sentry.io/0
# Exposed to the browser at build time as NEXT_PUBLIC_SENTRY_DSN_WEB
# Optional — upload source maps during Vercel build (requires Sentry auth token)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=propninja-web
