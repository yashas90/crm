PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propninja
# Postgres pool size per API instance (default 10). Use 20–30 for ~20 concurrent agents.
DATABASE_POOL_MAX=25
NODE_ENV=development
DEMO_ORG_ID=00000000-0000-0000-0000-0000000000aa
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_USER_EMAIL=demo@propninja.local
DEMO_USER_NAME=Demo Agent
DEMO_USER_ROLE=admin
DEMO_ORG_NAME=Demo Organization
DEMO_ORG_SLUG=demo
ALLOW_DEMO_AUTH=false
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# Optional — Sentry DSN for API error tracking (leave unset to disable)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Release tracking (set automatically on Railway)
# RAILWAY_GIT_COMMIT_SHA=
# Optional — Redis for distributed rate limiting (in-memory fallback when unset)
# REDIS_URL=redis://localhost:6379
# Comma-separated production web origins (no wildcards). Example:
# CORS_ORIGINS=https://www.ninjamarketing.in,https://ninjamarketing.in
CORS_ORIGINS=

# --- Mobile force-update ---
# Default in code is 1.0.7 (current APK). Older installs are blocked automatically.
# Raise this after each new APK ship. Set empty to disable locally.
MIN_MOBILE_APP_VERSION=1.0.7
# Optional link shown on the "Update required" screen (Play Store / hosted APK / internal page).
MOBILE_UPDATE_URL=https://www.ninjamarketing.in/download

# --- Meta Lead Ads (Facebook / Instagram) ---
# Set to true in production to require META_VERIFY_TOKEN + META_APP_SECRET at startup.
# META_WEBHOOK_ENABLED=false
# Webhook URL to register in Meta Developer Console:
#   https://<api-domain>/api/integrations/meta/webhook
# Verify token for subscription handshake (you choose this value; required when META_WEBHOOK_ENABLED=true)
# META_VERIFY_TOKEN=change-me-to-a-secret-string
# Verifies X-Hub-Signature-256 on POST webhooks (required when META_WEBHOOK_ENABLED=true; always enforced when NODE_ENV=production)
# META_APP_SECRET=
# META_APP_ID=
# META_OAUTH_REDIRECT_URI=https://<api-domain>/api/meta/oauth/callback
# Enable server-side Conversions API (Lead/Contact/Purchase events to your Pixel)
# META_CAPI_ENABLED=true
# Preferred Dataset / Pixel ID (Events Manager dataset ID), e.g. ninja
# META_CAPI_PIXEL_ID=1584337709911930
# META_CAPI_PIXEL_NAME=ninja
# Optional test code from Events Manager → Test Events
# META_CAPI_TEST_EVENT_CODE=
# PAGE_ACCESS_TOKEN=
# When set, only leads from this Page ID are ingested
# META_PAGE_ID=
# When set, only these form IDs are ingested (comma-separated)
# META_FORM_IDS=123456789,987654321

# --- Email (password reset + notifications) ---
# Required for password reset emails and scheduled report emails.
# Get API key at https://resend.com — free tier covers 3,000 emails/month.
# WEB_APP_URL=https://your-web-app.vercel.app
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Agent location & call-log tracking ---
# Working hours are evaluated in TRACKING_TIMEZONE (default Asia/Kolkata).
TRACKING_TIMEZONE=Asia/Kolkata
TRACKING_START_TIME=09:30
TRACKING_END_TIME=20:30
TRACKING_INTERVAL_MINUTES=30
TRACKING_RETENTION_DAYS=14
# Alert when last ping is older than this during working hours ( > 2× interval).
TRACKING_MISSING_ALERT_MINUTES=75
TRACKING_ENABLED=true
TRACKING_HEARTBEAT_THRESHOLD_MINUTES=60
TRACKING_POSSIBLE_UNINSTALL_MINUTES=180

# --- Google Ads lead form sync ---
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_SYNC_ENABLED=false
# GOOGLE_ADS_SYNC_INTERVAL_MS=600000
# GOOGLE_ADS_LOOKBACK_MINUTES=70
# GOOGLE_ADS_SYNC_OVERLAP_MINUTES=5
