      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --brand-blue: #1E3A8A; /* Dark Blue */\n    --brand-red: #DC2626;  /* Red */\n    --bg-light: #F8FAFC;\n    --glass-bg: rgba(255, 255, 255, 0.5);\n    --glass-border: rgba(255, 255, 255, 0.3);\n  }\n\n  body {\n    font-family: 'Lato', sans-serif;\n    color: #334155;\n    background-color: var(--bg-light);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n\n  .glass-card {\n    background: var(--glass-bg);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid var(--glass-border);\n    box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.05);\n  }\n\n  .red-glow {\n    box-shadow: 0 0 15px rgba(220, 38, 38, 0.1);\n    border-color: rgba(220, 38, 38, 0.2);\n  }\n\n  .red-pulse {\n    animation: red-glow-pulse 2s infinite alternate;\n  }\n\n  @keyframes red-glow-pulse {\n    from { box-shadow: 0 0 5px rgba(220, 38, 38, 0.1); }\n    to { box-shadow: 0 0 15px rgba(220, 38, 38, 0.3); }\n  }\n\n  .laser-line-red {\n    width: 2px;\n    background: linear-gradient(to bottom, transparent, var(--brand-red), transparent);\n    box-shadow: 0 0 8px var(--brand-red);\n  }\n\n  .mesh-gradient-light {\n    background-color: var(--bg-light);\n    background-image: \n      radial-gradient(at 0% 0%, rgba(30, 58, 138, 0.03) 0, transparent 50%),\n      radial-gradient(at 100% 100%, rgba(220, 38, 38, 0.03) 0, transparent 50%);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { height: 4px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(30, 58, 138, 0.1); border-radius: 10px; }\n\n  /* Smooth Carousel */\n  .carousel-container {\n    display: flex;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  .carousel-container::-webkit-scrollbar { display: none; }\n  .carousel-item {\n    scroll-snap-align: start;\n    flex: 0 0 85%;\n  }\n</style>\n\n<div class=\"relative min-h-screen mesh-gradient-light\" data-kid=\"1\">\n  \n  <div class=\"fixed inset-0 z-0\" data-kid=\"2\">\n    <img src=\"https://images.unsplash.com/photo-1515703944563-dbcfbf121b3d?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-5 blur-sm\" alt=\"Luxury Architecture\" decoding=\"async\" loading=\"lazy\" data-kid=\"3\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-white/20 via-white/40 to-white/90\" data-kid=\"4\"></div>\n  </div>\n\n  <div class=\"relative z-10 p-5 space-y-8\" data-kid=\"5\">\n    \n    <header class=\"space-y-6\" data-kid=\"6\">\n      <div class=\"text-center\" data-kid=\"7\">\n        <span class=\"text-[10px] uppercase tracking-[0.3em] text-[var(--brand-blue)] font-bold mb-1 block\" data-kid=\"8\">Command Centre Mobile</span>\n        <h1 class=\"text-4xl font-serif font-bold text-[var(--brand-blue)] tracking-tight\" data-kid=\"9\">PropNinja <span class=\"text-[var(--brand-red)]\" data-kid=\"10\">Portal</span></h1>\n        <p class=\"text-slate-500 mt-1 text-sm font-light\" data-kid=\"11\">Elegance in management.</p>\n      </div>\n      \n      <div class=\"grid grid-cols-2 gap-3\" data-kid=\"12\">\n        <button class=\"glass-card px-4 py-3 rounded-2xl text-[10px] font-bold border-[var(--brand-red)]/20 text-[var(--brand-red)] flex flex-col items-center justify-center gap-1\" data-kid=\"13\">\n          <i class=\"ti ti-users text-lg\" data-kid=\"14\"></i>\n          My Leads\n        </button>\n        <button class=\"glass-card px-4 py-3 rounded-2xl text-[10px] font-bold border-[var(--brand-blue)]/20 text-[var(--brand-blue)] flex flex-col items-center justify-center gap-1\" data-kid=\"15\">\n          <i class=\"ti ti-phone-call text-lg\" data-kid=\"16\"></i>\n          Log Call\n        </button>\n      </div>\n    </header>\n\n    \n    <section class=\"space-y-4\" data-kid=\"17\">\n      <div class=\"glass-card p-6 rounded-[2rem] border-[var(--brand-blue)]/5 relative overflow-hidden\" data-kid=\"18\">\n        <div class=\"absolute -right-2 -top-2 text-[var(--brand-blue)]/5\" data-kid=\"19\">\n          <i class=\"ti ti-users text-7xl\" data-kid=\"20\"></i>\n        </div>\n        <h3 class=\"text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"21\">Portfolio</h3>\n        <div class=\"flex items-baseline gap-2\" data-kid=\"22\">\n          <span class=\"text-3xl font-serif font-bold text-[var(--brand-blue)]\" data-kid=\"23\">1,248</span>\n          <span class=\"text-emerald-500 text-[10px] font-bold\" data-kid=\"24\">+12%</span>\n        </div>\n      </div>\n\n      <div class=\"glass-card red-glow p-6 rounded-[2rem] border-[var(--brand-red)]/10 relative overflow-hidden\" data-kid=\"25\">\n        <div class=\"absolute -right-2 -top-2 text-[var(--brand-red)]/5\" data-kid=\"26\">\n          <i class=\"ti ti-flame text-7xl\" data-kid=\"27\"></i>\n        </div>\n        <h3 class=\"text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"28\">Priority</h3>\n        <div class=\"flex items-baseline gap-2\" data-kid=\"29\">\n          <span class=\"text-3xl font-serif font-bold text-[var(--brand-red)]\" data-kid=\"30\">42</span>\n          <span class=\"text-[var(--brand-red)]/50 text-[10px] font-bold\" data-kid=\"31\">Hot</span>\n        </div>\n      </div>\n\n      <div class=\"glass-card red-pulse p-6 rounded-[2rem] border-[var(--brand-blue)]/10 relative overflow-hidden\" data-kid=\"32\">\n        <div class=\"absolute -right-2 -top-2 text-[var(--brand-blue)]/5\" data-kid=\"33\">\n          <i class=\"ti ti-clock text-7xl\" data-kid=\"34\"></i>\n        </div>\n        <h3 class=\"text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"35\">Follow-ups</h3>\n        <div class=\"flex items-baseline gap-2\" data-kid=\"36\">\n          <span class=\"text-3xl font-serif font-bold text-[var(--brand-blue)]\" data-kid=\"37\">09</span>\n          <span class=\"text-slate-400 text-[10px] font-bold\" data-kid=\"38\">Due Today</span>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"space-y-4\" data-kid=\"39\">\n      <h2 class=\"text-xl font-serif font-bold text-[var(--brand-blue)] px-1\" data-kid=\"40\">Daily Imperatives</h2>\n      <div class=\"carousel-container gap-4\" data-kid=\"41\">\n        <div class=\"carousel-item glass-card p-5 rounded-[1.5rem] border-l-4 border-l-[var(--brand-red)]\" data-kid=\"42\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"43\">\n            <span class=\"text-[9px] uppercase font-bold text-slate-400\" data-kid=\"44\">Call</span>\n            <span class=\"text-[9px] px-2 py-0.5 rounded bg-red-100 text-red-600 font-bold uppercase\" data-kid=\"45\">High</span>\n          </div>\n          <h4 class=\"text-[var(--brand-blue)] font-bold text-sm mb-1\" data-kid=\"46\">Villa Viewing</h4>\n          <p class=\"text-slate-500 text-xs line-clamp-2\" data-kid=\"47\">Confirm site visit with Mr. Cook for Riviera Mansion.</p>\n          <div class=\"flex items-center justify-between mt-4\" data-kid=\"48\">\n            <span class=\"text-[10px] text-[var(--brand-red)] font-bold\" data-kid=\"49\">14:00 PM</span>\n            <i class=\"ti ti-phone text-slate-400\" data-kid=\"50\"></i>\n          </div>\n        </div>\n        <div class=\"carousel-item glass-card p-5 rounded-[1.5rem] border-l-4 border-l-[var(--brand-blue)]\" data-kid=\"51\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"52\">\n            <span class=\"text-[9px] uppercase font-bold text-slate-400\" data-kid=\"53\">Follow-up</span>\n            <span class=\"text-[9px] px-2 py-0.5 rounded bg-blue-100 text-blue-600 font-bold uppercase\" data-kid=\"54\">Med</span>\n          </div>\n          <h4 class=\"text-[var(--brand-blue)] font-bold text-sm mb-1\" data-kid=\"55\">Contract Review</h4>\n          <p class=\"text-slate-500 text-xs line-clamp-2\" data-kid=\"56\">Check status of lease agreement for Downtown Lofts.</p>\n          <div class=\"flex items-center justify-between mt-4\" data-kid=\"57\">\n            <span class=\"text-[10px] text-[var(--brand-blue)] font-bold\" data-kid=\"58\">16:30 PM</span>\n            <i class=\"ti ti-file-text text-slate-400\" data-kid=\"59\"></i>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"space-y-4\" data-kid=\"60\">\n      <div class=\"flex items-center justify-between px-1\" data-kid=\"61\">\n        <h2 class=\"text-xl font-serif font-bold text-[var(--brand-blue)]\" data-kid=\"62\">Hot <span class=\"text-[var(--brand-red)]\" data-kid=\"63\">Leads</span></h2>\n        <button class=\"text-[10px] text-[var(--brand-blue)] font-bold underline\" data-kid=\"64\">View All</button>\n      </div>\n      <div class=\"space-y-3\" data-kid=\"65\">\n        <div class=\"glass-card p-4 rounded-2xl flex items-center justify-between\" data-kid=\"66\">\n          <div class=\"flex items-center gap-3\" data-kid=\"67\">\n            <div class=\"w-10 h-10 rounded-full border-2 border-[var(--brand-red)] p-0.5\" data-kid=\"68\">\n              <img src=\"https://i.pravatar.cc/100?u=alistair\" class=\"w-full h-full rounded-full object-cover\" alt=\"Avatar\" data-kid=\"69\">\n            </div>\n            <div data-kid=\"70\">\n              <h4 class=\"text-[var(--brand-blue)] text-xs font-bold\" data-kid=\"71\">Alistair Cook</h4>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"72\">Skyline Penthouse</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2\" data-kid=\"73\">\n            <div class=\"px-2 py-0.5 rounded-full bg-red-100 text-[var(--brand-red)] text-[8px] font-bold uppercase\" data-kid=\"74\">Hot</div>\n            <i class=\"ti ti-dots-vertical text-slate-300\" data-kid=\"75\"></i>\n          </div>\n        </div>\n        <div class=\"glass-card p-4 rounded-2xl flex items-center justify-between\" data-kid=\"76\">\n          <div class=\"flex items-center gap-3\" data-kid=\"77\">\n            <div class=\"w-10 h-10 rounded-full border-2 border-[var(--brand-red)] p-0.5\" data-kid=\"78\">\n              <img src=\"https://i.pravatar.cc/100?u=sophia\" class=\"w-full h-full rounded-full object-cover\" alt=\"Avatar\" data-kid=\"79\">\n            </div>\n            <div data-kid=\"80\">\n              <h4 class=\"text-[var(--brand-blue)] text-xs font-bold\" data-kid=\"81\">Sophia Loren</h4>\n              <p class=\"text-[10px] text-slate-400\" data-kid=\"82\">Garden Estates</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2\" data-kid=\"83\">\n            <div class=\"px-2 py-0.5 rounded-full bg-red-100 text-[var(--brand-red)] text-[8px] font-bold uppercase\" data-kid=\"84\">Hot</div>\n            <i class=\"ti ti-dots-vertical text-slate-300\" data-kid=\"85\"></i>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"space-y-6 pt-4\" data-kid=\"86\">\n      <div class=\"glass-card rounded-[2rem] p-6 border-[var(--brand-blue)]/5\" data-kid=\"87\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"88\">\n          <div class=\"w-8 h-8 rounded-lg glass-card border-[var(--brand-red)]/20 flex items-center justify-center text-[var(--brand-red)]\" data-kid=\"89\">\n            <i class=\"ti ti-bell-ringing text-sm\" data-kid=\"90\"></i>\n          </div>\n          <h3 class=\"text-lg font-serif font-bold text-[var(--brand-blue)]\" data-kid=\"91\">Reminders</h3>\n        </div>\n        \n        <div class=\"space-y-6\" data-kid=\"92\">\n          <div class=\"relative pl-6 pb-2 border-l 