      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --gold: #D4AF37;\n    --cyan: #22D3EE;\n    --navy: #0A0F1C;\n    --glass-bg: rgba(255, 255, 255, 0.05);\n    --glass-border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    font-family: 'Lato', sans-serif;\n    color: #F3F4F6;\n    background-color: var(--navy);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n\n  .glass-card {\n    background: var(--glass-bg);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid var(--glass-border);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n  }\n\n  .gold-glow {\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);\n    border-color: rgba(212, 175, 55, 0.3);\n  }\n\n  .cyan-pulse {\n    animation: cyan-glow 2s infinite alternate;\n  }\n\n  @keyframes cyan-glow {\n    from { box-shadow: 0 0 5px rgba(34, 211, 238, 0.2); }\n    to { box-shadow: 0 0 20px rgba(34, 211, 238, 0.5); }\n  }\n\n  .laser-line {\n    width: 2px;\n    background: linear-gradient(to bottom, transparent, var(--cyan), transparent);\n    box-shadow: 0 0 8px var(--cyan);\n  }\n\n  .mesh-gradient {\n    background-color: var(--navy);\n    background-image: \n      radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.05) 0, transparent 50%),\n      radial-gradient(at 100% 100%, rgba(34, 211, 238, 0.05) 0, transparent 50%);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }\n</style>\n\n<div class=\"relative min-h-screen mesh-gradient\" data-kid=\"1\">\n  \n  <div class=\"fixed inset-0 z-0\" data-kid=\"2\">\n    <img src=\"https://images.unsplash.com/photo-1515703944563-dbcfbf121b3d?auto=format&w=1440&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-20 blur-sm\" alt=\"Luxury Architecture\" decoding=\"async\" loading=\"lazy\" data-kid=\"3\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-[#0A0F1C]/80 to-[#0A0F1C]\" data-kid=\"4\"></div>\n  </div>\n\n  <div class=\"relative z-10 max-w-7xl mx-auto px-6 py-10\" data-kid=\"5\">\n    \n    <header class=\"mb-12 flex items-end justify-between\" data-kid=\"6\">\n      <div data-kid=\"7\">\n        <span class=\"text-xs uppercase tracking-[0.3em] text-[var(--gold)] font-bold mb-2 block\" data-kid=\"8\">Agent Command Centre</span>\n        <h1 class=\"text-5xl font-serif font-bold text-white tracking-tight\" data-kid=\"9\">PropNinja <span class=\"text-[var(--gold)]\" data-kid=\"10\">Dashboard</span></h1>\n        <p class=\"text-slate-400 mt-2 text-lg font-light\" data-kid=\"11\">Elegance in management. Precision in results.</p>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"12\">\n        <button class=\"glass-card px-6 py-3 rounded-full text-sm font-medium border-[var(--gold)]/30 text-[var(--gold)] flex items-center gap-2 hover:bg-[var(--gold)]/10 transition-all duration-300\" data-kid=\"13\">\n          <i class=\"ti ti-users text-lg\" data-kid=\"14\"></i>\n          View My Leads\n        </button>\n        <button class=\"glass-card px-6 py-3 rounded-full text-sm font-medium border-white/20 text-white flex items-center gap-2 hover:bg-white/5 transition-all duration-300\" data-kid=\"15\">\n          <i class=\"ti ti-phone-call text-lg\" data-kid=\"16\"></i>\n          Log a Call\n        </button>\n      </div>\n    </header>\n\n    <div class=\"grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10\" data-kid=\"17\">\n      <main class=\"space-y-12\" data-kid=\"18\">\n        \n        <section class=\"grid grid-cols-1 md:grid-cols-3 gap-6\" data-kid=\"19\">\n          <div class=\"glass-card gold-glow p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"20\">\n            <div class=\"absolute -right-4 -top-4 text-white/5 group-hover:text-white/10 transition-colors\" data-kid=\"21\">\n              <i class=\"ti ti-users text-9xl\" data-kid=\"22\"></i>\n            </div>\n            <h3 class=\"text-slate-400 text-sm font-medium uppercase tracking-widest mb-4\" data-kid=\"23\">Total Portfolio</h3>\n            <div class=\"flex items-baseline gap-2\" data-kid=\"24\">\n              <span class=\"text-4xl font-serif font-bold text-white tracking-tighter\" data-kid=\"25\">1,248</span>\n              <span class=\"text-emerald-400 text-xs font-bold\" data-kid=\"26\">+12%</span>\n            </div>\n            <p class=\"text-xs text-slate-500 mt-4\" data-kid=\"27\">Active leads in system</p>\n          </div>\n\n          <div class=\"glass-card gold-glow p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"28\">\n            <div class=\"absolute -right-4 -top-4 text-[var(--gold)]/5 group-hover:text-[var(--gold)]/10 transition-colors\" data-kid=\"29\">\n              <i class=\"ti ti-flame text-9xl\" data-kid=\"30\"></i>\n            </div>\n            <h3 class=\"text-slate-400 text-sm font-medium uppercase tracking-widest mb-4\" data-kid=\"31\">High Priority</h3>\n            <div class=\"flex items-baseline gap-2\" data-kid=\"32\">\n              <span class=\"text-4xl font-serif font-bold text-[var(--gold)] tracking-tighter\" data-kid=\"33\">42</span>\n              <span class=\"text-[var(--gold)]/60 text-xs font-bold\" data-kid=\"34\">Hot</span>\n            </div>\n            <p class=\"text-xs text-slate-500 mt-4\" data-kid=\"35\">Require immediate attention</p>\n          </div>\n\n          <div class=\"glass-card cyan-pulse p-8 rounded-3xl border-[var(--cyan)]/20 relative overflow-hidden group\" data-kid=\"36\">\n            <div class=\"absolute -right-4 -top-4 text-[var(--cyan)]/5 group-hover:text-[var(--cyan)]/10 transition-colors\" data-kid=\"37\">\n              <i class=\"ti ti-clock text-9xl\" data-kid=\"38\"></i>\n            </div>\n            <h3 class=\"text-slate-400 text-sm font-medium uppercase tracking-widest mb-4\" data-kid=\"39\">Follow-ups</h3>\n            <div class=\"flex items-baseline gap-2\" data-kid=\"40\">\n              <span class=\"text-4xl font-serif font-bold text-[var(--cyan)] tracking-tighter\" data-kid=\"41\">09</span>\n              <span class=\"text-[var(--cyan)]/60 text-xs font-bold\" data-kid=\"42\">Due Today</span>\n            </div>\n            <p class=\"text-xs text-slate-500 mt-4\" data-kid=\"43\">Scheduled engagement window</p>\n          </div>\n        </section>\n\n        \n        <section class=\"glass-card rounded-[2.5rem] p-8\" data-kid=\"44\">\n          <div class=\"flex items-center justify-between mb-8\" data-kid=\"45\">\n            <h2 class=\"text-2xl font-serif font-bold text-white\" data-kid=\"46\">Daily Imperatives</h2>\n            <div class=\"flex gap-2\" data-kid=\"47\">\n              <button class=\"w-10 h-10 rounded-full glass-card flex items-center justify-center hover:bg-white/10 transition-all\" data-kid=\"48\">\n                <i class=\"ti ti-chevron-left text-white\" data-kid=\"49\"></i>\n              </button>\n              <button class=\"w-10 h-10 rounded-full glass-card flex items-center justify-center hover:bg-white/10 transition-all\" data-kid=\"50\">\n                <i class=\"ti ti-chevron-right text-white\" data-kid=\"51\"></i>\n              </button>\n            </div>\n          </div>\n          <div class=\"flex gap-6 overflow-hidden\" data-kid=\"52\">\n            <div class=\"min-w-[300px] glass-card bg-white/5 p-6 rounded-2xl border-l-4 border-l-[var(--gold)] hover:scale-[1.02] transition-transform\" data-kid=\"53\">\n              <div class=\"flex justify-between items-start mb-4\" data-kid=\"54\">\n                <span class=\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\" data-kid=\"55\">Call</span>\n                <span class=\"text-[10px] px-2 py-1 rounded bg-amber-500/20 text-amber-500 font-bold uppercase\" data-kid=\"56\">High</span>\n              </div>\n              <h4 class=\"text-white font-bold mb-2\" data-kid=\"57\">Luxury Villa Viewing</h4>\n              <p class=\"text-slate-400 text-sm mb-4\" data-kid=\"58\">Confirm site visit with Mr. Alistair Cook for the Riviera Mansion.</p>\n              <div class=\"flex items-center justify-between mt-auto\" data-kid=\"59\">\n                <span class=\"text-xs text-[var(--gold)] font-bold\" data-kid=\"60\">14:00 PM</span>\n                <i class=\"ti ti-phone text-slate-400\" data-kid=\"61\"></i>\n              </div>\n            </div>\n            <div class=\"min-w-[300px] glass-card bg-white/5 p-6 rounded-2xl border-l-4 border-l-[var(--cyan)] hover:scale-[1.02] transition-transform opacity-70\" data-kid=\"62\">\n              <div class=\"flex justify-between items-start mb-4\" data-kid=\"63\">\n                <span class=\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\" data-kid=\"64\">Follow-up</span>\n                <span class=\"text-[10px] px-2 py-1 rounded bg-slate-500/20 text-slate-400 font-bold uppercase\" data-kid=\"65\">Med</span>\n              </div>\n              <h4 class=\"text-white font-bold mb-2\" data-kid=\"66\">Contract Review</h4>\n              <p class=\"text-slate-400 text-sm mb-4\" data-kid=\"67\">Check status of lease agreement for the Downtown Loft units.</p>\n              <div class=\"flex items-center justify-between mt-auto\" data-kid=\"68\">\n                <span class=\"text-xs text-[var(--cyan)] font-bold\" data-kid=\"69\">16:30 PM</span>\n                <i class=\"ti ti-file-text text-slate-400\" data-kid=\"70\"></i>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        \n        <section data-kid=\"71\">\n          <div class=\"flex items-end justify-between mb-8\" data-kid=\"72\">\n            <div data-kid=\"73\">\n              <h2 class=\"text-3xl font-serif font-bold text-white mb-2\" data-kid=\"74\">Hot <span class=\"text-[var(--gold)]\" data-kid=\"75\">Leads</span></h2>\n              <p class=\"text-slate-400 font-light\" data-kid=\"76\">Leads exhibiting high intent and engagement scores.</p>\n            </div>\n            <button class=\"text-sm text-[var(--gold)] hover:underline flex items-center gap-1 font-bold\" data-kid=\"77\">\n              View all leads <i class=\"ti ti-arrow-up-right\" data-kid=\"78\"></i>\n            </button>\n          </div>\n          <div class=\"space-y-4\" data-kid=\"79\">\n            \n            <div class=\"glass-card p-4 rounded-2xl flex items-center justify-between hover:bg-white/10 transition-colors group\" data-kid=\"80\">\n              <div class=\"flex items-center gap-4\" data-kid=\"81\">\n                <div class=\"relative\" data-kid=\"82\">\n                  <div class=\"w-12 h-12 rounded-full border-2 border-[var(--gold)] p-0.5 glow-pulse\" data-kid=\"83\">\n                    <img src=\"https://i.pravatar.cc/100?u=alistair\" class=\"w-full h-full rounded-full object-cover\" alt=\"Avatar\" data-kid=\"84\">\n                  </div>\n                  <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-2 border-[var(--navy)] rounded-full\" data-kid=\"85\"></div>\n                </div>\n                <div data-kid=\"86\">\n                  <h4 class=\"text-white font-bold group-hover:text-[var(--gold)] transition-colors\" data-kid=\"87\">Alistair Cook</h4>\n                  <p class=\"text-slate-400 text-xs font-light\" data-kid=\"88\">Interested in: <span class=\"text-slate-200\" data-kid=\"89\">Skyline Penthouse</span></p>\n                </div>\n              </div>\n              <div class=\"hidden md:block\" data-kid=\"90\">\n                <p class=\"text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-1\" data-kid=\"91\">Location</p>\n                <p class=\"text-white text-sm\" data-kid=\"92\">Dubai Marina, UAE</p>\n              </div>\n              <div class=\"hidden lg:block\" data-kid=\"93\">\n                <p class=\"text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-1\" data-kid=\"94\">Last Contact</p>\n                <p class=\"text-white text-sm\" data-kid=\"95\">2 hours ago</p>\n              </div>\n              <div class=\"flex items-center gap-4\" data-kid=\"96\">\n                <div class=\"px-3 py-1 rounded-full bg-[var(--gold)]/10 text-[var(--gold)] text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"97\">Hot Intent</div>\n                <button class=\"w-8 h-8 rounded-full glass-card flex items-center justify-center hover:bg-[var(--gold)] hover:text-[var(--navy)] transition-all\" data-kid=\"98\">\n                  <i class=\"ti ti-dots-vertical\" data-kid=\"99\"></i>\n                </button>\n              </div>\n            </div>\n\n            <div class=\"glass-card p-4 rounded-2xl flex items-center justify-between hover:bg-white/10 transition-colors group\" data-kid=\"100\">\n              <div class=\"flex items-center gap-4\" data-kid=\"101\">\n                <div class=\"relative\" data-kid=\"102\">\n                  <div class=\"w-12 h-12 rounded-full border-2 border-[var(--gold)] p-0.5\" data-kid=\"103\">\n                    <img src=\"https://i.pravatar.cc/100?u=sophia\" class=\"w-full h-full rounded-full object-cover\" alt=\"Avatar\" data-kid=\"104\">\n                  </div>\n                  <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-amber-500 border-2 border-[var(--navy)] rounded-full\" data-kid=\"105\"></div>\n                </div>\n                <div data-kid=\"106\">\n                  <h4 class=\"text-white font-bold group-hover:text-[var(--gold)] transition-colors\" data-kid=\"107\">Sophia Loren</h4>\n                  <p class=\"text-slate-400 text-xs font-light\" data-kid=\"108\">Interested in: <span class=\"text-slate-200\" data-kid=\"109\">Garden Estates</span></p>\n                </div>\n              </div>\n              <div class=\"hidden md:block\" data-kid=\"110\">\n                <p class=\"text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-1\" data-kid=\"111\">Location</p>\n                <p class=\"text-white text-sm\" data-kid=\"112\">London, UK</p>\n              </div>\n              <div class=\"hidden lg:block\" data-kid=\"113\">\n                <p class=\"text-slate-500 text-[10px] uppercase font-bold tracking-widest mb-1\" data-kid=\"114\">Last Contact</p>\n                <p class=\"text-white text-sm\" data-kid=\"115\">Yesterday</p>\n              </div>\n              <div class=\"flex items-center gap-4\" data-kid=\"116\">\n                <div class=\"px-3 py-1 rounded-full bg-[var(--gold)]/10 text-[var(--gold)] text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"117\">Hot Intent</div>\n                <button class=\"w-8 h-8 rounded-full glass-card flex items-center justify-center hover:bg-[var(--gold)] hover:text-[var(--navy)] transition-all\" data-kid=\"118\">\n                  <i class=\"ti ti-dots-vertical\" data-kid=\"119\"></i>\n                </button>\n              </div>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      \n      <aside class=\"space-y-10\" data-kid=\"120\">\n        \n        <div class=\"glass-card rounded-[2rem] p-6 sticky top-10 border-white/5 shadow-2xl\" data-kid=\"121\">\n          <div class=\"flex items-center gap-3 mb-8\" data-kid=\"122\">\n            <div class=\"w-10 h-10 rounded-xl glass-card border-[var(--cyan)]/30 flex items-center justify-center text-[var(--cyan)] shadow-[0_0_15px_rgba(34,211,238,0.2)]\" data-kid=\"123\">\n              <i class=\"ti ti-bell-ringing text-xl\" data-kid=\"124\"></i>\n            </div>\n            <h3 class=\"text-xl font-serif font-bold text-white\" data-kid=\"125\">Reminders</h3>\n          </div>\n          \n          <div class=\"space-y-6\" data-kid=\"126\">\n            <div class=\"relative pl-6 pb-6 border-l border-white/10 group\" data-kid=\"127\">\n              <div class=\"absolute left-[-5px] top-0 w-2.5 h-2.5 rounded-full bg-[var(--cyan)] shadow-[0_0_10px_var(--cyan)]\" data-kid=\"128\"></div>\n              <span class=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 block\" data-kid=\"129\">In 2 Hours</span>\n              <p class=\"text-white text-sm font-medium leading-relaxed\" data-kid=\"130\">Call Alistair to finalize the down payment documents.</p>\n              <button class=\"mt-2 text-[10px] font-bold text-[var(--gold)] uppercase hover:underline\" data-kid=\"131\">Snooze</button>\n            </div>\n            <div class=\"relative pl-6 pb-6 border-l border-white/10 group opacity-60 hover:opacity-100 transition-opacity\" data-kid=\"132\">\n              <div class=\"absolute left-[-5px] top-0 w-2.5 h-2.5 rounded-full bg-slate-500\" data-kid=\"133\"></div>\n              <span class=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 block\" data-kid=\"134\">Tomorrow, 10:00</span>\n              <p class=\"text-white text-sm font-medium leading-relaxed\" data-kid=\"135\">Weekly sync with the Property Development team.</p>\n              <button class=\"mt-2 text-[10px] font-bold text-[var(--gold)] uppercase hover:underline\" data-kid=\"136\">Dismiss</button>\n            </div>\n          </div>\n          \n          <div class=\"mt-10 p-4 rounded-2xl bg-white/5 border border-white/5\" data-kid=\"137\">\n            <p class=\"text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-3\" data-kid=\"138\">Recent Activity</p>\n            <div class=\"relative\" data-kid=\"139\">\n              <div class=\"laser-line absolute left-3 top-0 bottom-0\" data-kid=\"140\"></div>\n              <div class=\"space-y-6\" data-kid=\"141\">\n                <div class=\"relative pl-10\" data-kid=\"142\">\n                  <div class=\"absolute left-0 top-0 w-6 h-6 rounded-full glass-card border-[var(--cyan)]/30 flex items-center justify-center z-10\" data-kid=\"143\">\n                    <i class=\"ti ti-microphone text-[10px] text-[var(--cyan)]\" data-kid=\"144\"></i>\n                  </div>\n                  <p class=\"text-xs text-white font-medium\" data-kid=\"145\">Logged a voice note for <span class=\"text-[var(--gold)]\" data-kid=\"146\">Skyline Unit 4B</span></p>\n                  <span class=\"text-[10px] text-slate-500 font-bold\" data-kid=\"147\">12:30 PM</span>\n                </div>\n                <div class=\"relative pl-10\" data-kid=\"148\">\n                  <div class=\"absolute left-0 top-0 w-6 h-6 rounded-full glass-card border-[var(--gold)]/30 flex items-center justify-center z-10\" data-kid=\"149\">\n                    <i class=\"ti ti-pencil text-[10px] text-[var(--gold)]\" data-kid=\"150\"></i>\n                  </div>\n                  <p class=\"text-xs text-white font-medium\" data-kid=\"151\">Updated status to <span class=\"text-emerald-400\" data-kid=\"152\">Lease Signed</span></p>\n                  <span class=\"text-[10px] text-slate-500 font-bold\" data-kid=\"153\">10:45 AM</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </aside>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"154\"></script>\n<script data-kid=\"155\">\n  // Initial entrance animations\n  gsap.from(\".glass-card\", {\n    y: 30,\n    opacity: 0,\n    duration: 1.2,\n    stagger: 0.1,\n    ease: \"expo.out\",\n    backdropFilter: \"blur(0px)\"\n  });\n\n  gsap.from(\"h1, p\", {\n    x: -30,\n    opacity: 0,\n    duration: 1.5,\n    stagger: 0.2,\n    ease: \"power3.out\"\n  });\n\n  // Timeline laser line animation\n  gsap.from(\".laser-line\", {\n    height: 0,\n    duration: 2,\n    ease: \"power4.inOut\"\n  });\n\n  // Subtle hovering pulse for icons\n  gsap.to(\".glow-pulse\", {\n    borderColor: \"rgba(212, 175, 55, 0.8)\",\n    boxShadow: \"0 0 20px rgba(212, 175, 55, 0.4)\",\n    duration: 1.5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n</script>",
