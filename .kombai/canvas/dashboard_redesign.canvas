roup-hover:border-[#1A1D20]\" data-kid=\"74\">\n               <div class=\"w-1.5 h-1.5 bg-[#1A1D20]\" data-kid=\"75\"></div>\n            </div>\n            <div data-kid=\"76\">\n              <span class=\"font-mono text-[10px] text-[#9CA3AF] uppercase tracking-widest mb-2 block\" data-kid=\"77\">10:45 AM / NOTE ADDED</span>\n              <p class=\"font-bold text-xl tracking-tight\" data-kid=\"78\">Lead Status Change: Alexander Wright</p>\n              <p class=\"text-sm text-[#9CA3AF] mt-2 max-w-2xl leading-relaxed\" data-kid=\"79\">Moved from 'Contacted' to 'Qualified' after follow-up call regarding the penthouse unit. Client is ready for a second viewing.</p>\n            </div>\n          </div>\n\n          <div class=\"relative group\" data-kid=\"80\">\n            <div class=\"absolute -left-[52px] top-1.5 w-4 h-4 bg-white border border-[#E5E7EB] flex items-center justify-center transition-colors group-hover:border-[#1A1D20]\" data-kid=\"81\">\n               <div class=\"w-1.5 h-1.5 bg-[#E5E7EB] group-hover:bg-[#1A1D20]\" data-kid=\"82\"></div>\n            </div>\n            <div data-kid=\"83\">\n              <span class=\"font-mono text-[10px] text-[#9CA3AF] uppercase tracking-widest mb-2 block\" data-kid=\"84\">09:12 AM / CALL LOGGED</span>\n              <p class=\"font-bold text-xl tracking-tight\" data-kid=\"85\">Outgoing Call: Sarah Jenkins</p>\n              <p class=\"text-sm text-[#9CA3AF] mt-2 max-w-2xl leading-relaxed\" data-kid=\"86\">Duration: 4m 22s. Customer expressed interest in viewing the new downtown listings and asked for a brochure via email.</p>\n            </div>\n          </div>\n\n          <div class=\"relative group\" data-kid=\"87\">\n            <div class=\"absolute -left-[52px] top-1.5 w-4 h-4 bg-white border border-[#E5E7EB] flex items-center justify-center transition-colors group-hover:border-[#1A1D20]\" data-kid=\"88\">\n               <div class=\"w-1.5 h-1.5 bg-[#E5E7EB] group-hover:bg-[#1A1D20]\" data-kid=\"89\"></div>\n            </div>\n            <div data-kid=\"90\">\n              <span class=\"font-mono text-[10px] text-[#9CA3AF] uppercase tracking-widest mb-2 block\" data-kid=\"91\">08:30 AM / SYSTEM ALERT</span>\n              <p class=\"font-bold text-xl tracking-tight\" data-kid=\"92\">New Inbound Lead: Jordan Smith</p>\n              <p class=\"text-sm text-[#9CA3AF] mt-2 max-w-2xl leading-relaxed\" data-kid=\"93\">Source: Website Contact Form. Interested in commercial property leasing on 5th Avenue.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </main>\n\n    \n    <aside class=\"col-span-3\" data-kid=\"94\">\n      <div class=\"sticky top-12 border-l border-[#E5E7EB] pl-12 py-2\" data-kid=\"95\">\n        <h2 class=\"text-xs font-bold uppercase tracking-[0.25em] text-[#9CA3AF] mb-12\" data-kid=\"96\">Scheduled / Reminders</h2>\n        \n        <div class=\"space-y-16\" data-kid=\"97\">\n          <div class=\"group\" data-kid=\"98\">\n            <div class=\"flex items-center mb-3\" data-kid=\"99\">\n              <i class=\"ti ti-clock text-xs mr-3 text-[#748C70]\" data-kid=\"100\"></i>\n              <span class=\"font-mono text-[10px] font-bold text-[#748C70] tracking-widest uppercase\" data-kid=\"101\">IN 15 MIN</span>\n            </div>\n            <p class=\"font-bold text-lg tracking-tight leading-snug\" data-kid=\"102\">Follow up with Marcus about contract signature</p>\n            <button class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF] hover:text-[#1A1D20] transition-colors flex items-center\" data-kid=\"103\">\n              Snooze / Dismiss\n              <i class=\"ti ti-arrow-up-right ml-1 text-[8px]\" data-kid=\"104\"></i>\n            </button>\n          </div>\n\n          <div class=\"group\" data-kid=\"105\">\n            <div class=\"flex items-center mb-3\" data-kid=\"106\">\n              <i class=\"ti ti-clock text-xs mr-3 text-[#9CA3AF]\" data-kid=\"107\"></i>\n              <span class=\"font-mono text-[10px] text-[#9CA3AF] tracking-widest uppercase\" data-kid=\"108\">02:30 PM</span>\n            </div>\n            <p class=\"font-bold text-lg tracking-tight leading-snug\" data-kid=\"109\">Property showing: 422 West Oak Avenue</p>\n            <button class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF] hover:text-[#1A1D20] transition-colors flex items-center\" data-kid=\"110\">\n              Snooze / Dismiss\n              <i class=\"ti ti-arrow-up-right ml-1 text-[8px]\" data-kid=\"111\"></i>\n            </button>\n          </div>\n\n          <div class=\"group opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all\" data-kid=\"112\">\n            <div class=\"flex items-center mb-3\" data-kid=\"113\">\n              <i class=\"ti ti-clock text-xs mr-3 text-[#9CA3AF]\" data-kid=\"114\"></i>\n              <span class=\"font-mono text-[10px] text-[#9CA3AF] tracking-widest uppercase\" data-kid=\"115\">04:45 PM</span>\n            </div>\n            <p class=\"font-bold text-lg tracking-tight leading-snug\" data-kid=\"116\">Weekly team sync via Zoom</p>\n            <button class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF] hover:text-[#1A1D20] transition-colors flex items-center\" data-kid=\"117\">\n              Snooze / Dismiss\n              <i class=\"ti ti-arrow-up-right ml-1 text-[8px]\" data-kid=\"118\"></i>\n            </button>\n          </div>\n        </div>\n      </div>\n    </aside>\n  </div>\n</div>",
