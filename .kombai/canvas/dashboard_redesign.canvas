      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-inter { font-family: 'Inter', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n</style>\n\n<div class=\"min-h-screen bg-[#F7F7F9] font-inter text-[#1A1D20] p-12\" data-kid=\"1\">\n  \n  <header class=\"flex justify-between items-end border-b border-[#E5E7EB] pb-16 mb-16\" data-kid=\"2\">\n    <div data-kid=\"3\">\n      <h1 class=\"text-6xl font-extrabold tracking-tighter uppercase leading-none\" data-kid=\"4\">My Dashboard</h1>\n      <p class=\"text-[#9CA3AF] mt-4 font-mono text-sm tracking-tight\" data-kid=\"5\">PROPNINJA / AGENT_WORKSPACE / <span class=\"text-[#1A1D20]\" data-kid=\"6\">2026_06_23</span></p>\n    </div>\n    \n    <div class=\"flex items-center\" data-kid=\"7\">\n      <div class=\"px-12 text-right\" data-kid=\"8\">\n        <span class=\"block text-[10px] font-bold uppercase tracking-[0.3em] text-[#9CA3AF] mb-2\" data-kid=\"9\">My Leads</span>\n        <span class=\"text-5xl font-bold font-mono tracking-tighter\" data-kid=\"10\">124</span>\n      </div>\n      <div class=\"w-[1px] h-16 bg-[#E5E7EB]\" data-kid=\"11\"></div>\n      <div class=\"px-12 text-right\" data-kid=\"12\">\n        <span class=\"block text-[10px] font-bold uppercase tracking-[0.3em] text-[#9CA3AF] mb-2\" data-kid=\"13\">Hot Leads</span>\n        <span class=\"text-5xl font-bold font-mono tracking-tighter text-[#748C70]\" data-kid=\"14\">18</span>\n      </div>\n      <div class=\"w-[1px] h-16 bg-[#E5E7EB]\" data-kid=\"15\"></div>\n      <div class=\"px-12 text-right\" data-kid=\"16\">\n        <span class=\"block text-[10px] font-bold uppercase tracking-[0.3em] text-[#9CA3AF] mb-2\" data-kid=\"17\">Follow-ups Due</span>\n        <span class=\"text-5xl font-bold font-mono tracking-tighter\" data-kid=\"18\">06</span>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"grid grid-cols-12 gap-16\" data-kid=\"19\">\n    \n    <main class=\"col-span-9 space-y-24\" data-kid=\"20\">\n      \n      \n      <div class=\"flex gap-12\" data-kid=\"21\">\n        <a href=\"#\" class=\"group relative flex items-center text-sm font-bold uppercase tracking-widest\" data-kid=\"22\">\n          View my leads\n          <i class=\"ti ti-arrow-up-right ml-2 text-xs transition-transform group-hover:translate-x-1 group-hover:-translate-y-1\" data-kid=\"23\"></i>\n          <div class=\"h-[1px] bg-[#1A1D20] scale-x-0 group-hover:scale-x-100 transition-transform origin-left mt-1 absolute -bottom-1 w-full\" data-kid=\"24\"></div>\n        </a>\n        <a href=\"#\" class=\"group relative flex items-center text-sm font-bold uppercase tracking-widest\" data-kid=\"25\">\n          My calls\n          <i class=\"ti ti-arrow-up-right ml-2 text-xs transition-transform group-hover:translate-x-1 group-hover:-translate-y-1\" data-kid=\"26\"></i>\n          <div class=\"h-[1px] bg-[#1A1D20] scale-x-0 group-hover:scale-x-100 transition-transform origin-left mt-1 absolute -bottom-1 w-full\" data-kid=\"27\"></div>\n        </a>\n      </div>\n\n      \n      <section data-kid=\"28\">\n        <div class=\"mb-10 flex justify-between items-end\" data-kid=\"29\">\n          <h2 class=\"text-xs font-bold uppercase tracking-[0.25em] text-[#9CA3AF]\" data-kid=\"30\">Attention Required / Hot Leads</h2>\n          <span class=\"font-mono text-[10px] text-[#9CA3AF]\" data-kid=\"31\">SORT_BY: TEMPERATURE / DESC</span>\n        </div>\n        <table class=\"w-full text-left border-collapse\" data-kid=\"32\">\n          <thead data-kid=\"33\">\n            <tr class=\"border-b border-[#E5E7EB]\" data-kid=\"34\">\n              <th class=\"pb-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF]\" data-kid=\"35\">Lead Name</th>\n              <th class=\"pb-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF]\" data-kid=\"36\">Phone</th>\n              <th class=\"pb-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF]\" data-kid=\"37\">City</th>\n              <th class=\"pb-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF]\" data-kid=\"38\">Last Contact</th>\n              <th class=\"pb-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#9CA3AF] text-right\" data-kid=\"39\">Status</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-[#E5E7EB]/40\" data-kid=\"40\">\n            <tr class=\"group hover:bg-white transition-all duration-300 cursor-pointer\" data-kid=\"41\">\n              <td class=\"py-8 font-bold text-lg tracking-tight\" data-kid=\"42\">Alexander Wright</td>\n              <td class=\"py-8 font-mono text-xs text-[#9CA3AF]\" data-kid=\"43\">+1 415 555 0192</td>\n              <td class=\"py-8 text-sm\" data-kid=\"44\">San Francisco</td>\n              <td class=\"py-8 font-mono text-xs text-[#9CA3AF]\" data-kid=\"45\">2 HOURS AGO</td>\n              <td class=\"py-8 text-right\" data-kid=\"46\">\n                <span class=\"inline-flex items-center\" data-kid=\"47\">\n                  <span class=\"w-1.5 h-1.5 rounded-none bg-[#748C70] mr-3\" data-kid=\"48\"></span>\n                  <span class=\"text-[10px] font-bold uppercase tracking-[0.2em]\" data-kid=\"49\">Hot</span>\n                </span>\n              </td>\n            </tr>\n            <tr class=\"group hover:bg-white transition-all duration-300 cursor-pointer\" data-kid=\"50\">\n              <td class=\"py-8 font-bold text-lg tracking-tight\" data-kid=\"51\">Elena Rodriguez</td>\n              <td class=\"py-8 font-mono text-xs text-[#9CA3AF]\" data-kid=\"52\">+1 213 555 0482</td>\n              <td class=\"py-8 text-sm\" data-kid=\"53\">Los Angeles</td>\n              <td class=\"py-8 font-mono text-xs text-[#9CA3AF]\" data-kid=\"54\">YESTERDAY</td>\n              <td c