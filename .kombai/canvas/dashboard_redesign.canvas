      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #FFFBF2;\n    color: #000000;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  .font-heading {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .neubrutal-card {\n    background-color: #FFFFFF;\n    border: 2px solid #000000;\n    box-shadow: 4px 4px 0px 0px #000000;\n    transition: all 0.2s ease;\n  }\n\n  .neubrutal-card:hover {\n    transform: translate(-2px, -2px);\n    box-shadow: 6px 6px 0px 0px #000000;\n  }\n\n  .neubrutal-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0.75rem 1.5rem;\n    border: 2px solid #000000;\n    border-radius: 9999px;\n    background-color: #FFFFFF;\n    font-weight: 700;\n    box-shadow: 2px 2px 0px 0px #000000;\n    transition: all 0.1s ease;\n    cursor: pointer;\n  }\n\n  .neubrutal-btn:active {\n    transform: translate(1px, 1px);\n    box-shadow: 1px 1px 0px 0px #000000;\n  }\n\n  .neubrutal-table th {\n    border: 1px solid #000000;\n    background-color: #2563EB;\n    color: #FFFFFF;\n    padding: 1rem;\n    text-align: left;\n    font-family: 'Space Grotesk', sans-serif;\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    letter-spacing: 0.05em;\n  }\n\n  .neubrutal-table td {\n    border: 1px solid #000000;\n    padding: 1rem;\n    font-size: 0.875rem;\n  }\n\n  .neubrutal-table tr:hover td {\n    background-color: #F8FAFC;\n  }\n\n  .polaroid {\n    background: #FFFFFF;\n    border: 2px solid #000000;\n    padding: 1rem 1rem 2rem 1rem;\n    box-shadow: 4px 4px 0px 0px #000000;\n    transform: rotate(-1deg);\n  }\n\n  .polaroid:nth-child(even) {\n    transform: rotate(1.5deg);\n  }\n\n  .sticky-note {\n    background-color: #FEF08A;\n    border: 2px solid #000000;\n    box-shadow: 4px 4px 0px 0px #000000;\n    padding: 1.5rem;\n  }\n</style>\n\n<div class=\"min-h-screen p-8 lg:p-12\" data-kid=\"1\">\n  <div class=\"max-w-7xl mx-auto\" data-kid=\"2\">\n    \n    <header class=\"mb-12\" data-kid=\"3\">\n      <h1 class=\"font-heading text-6xl font-bold tracking-tighter mb-2 uppercase italic\" data-kid=\"4\">My Dashboard</h1>\n      <p class=\"text-xl font-medium text-neutral-600\" data-kid=\"5\">Real estate hustle, simplified. Track your leads and close deals.</p>\n    </header>\n\n    <div class=\"lg:grid lg:grid-cols-12 lg:gap-12\" data-kid=\"6\">\n      \n      <main class=\"lg:col-span-9 space-y-12\" data-kid=\"7\">\n        \n        \n        <section class=\"grid grid-cols-1 md:grid-cols-3 gap-6\" data-kid=\"8\">\n          <div class=\"neubrutal-card p-6 aspect-square flex flex-col justify-between\" data-kid=\"9\">\n            <span class=\"font-heading font-bold text-lg uppercase\" data-kid=\"10\">My Leads</span>\n            <div class=\"text-7xl font-bold tracking-tighter\" data-kid=\"11\">72</div>\n          </div>\n          <div class=\"neubrutal-card p-6 aspect-square flex flex-col justify-between bg-[#FF6B6B] text-white\" data-kid=\"12\">\n            <div class=\"flex justify-between items-start\" data-kid=\"13\">\n              <span class=\"font-heading font-bold text-lg uppercase\" data-kid=\"14\">Hot Leads</span>\n              <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"w-10 h-10\" alt=\"fire\" data-kid=\"15\">\n            </div>\n            <div class=\"text-7xl font-bold tracking-tighter\" data-kid=\"16\">12</div>\n          </div>\n          <div class=\"neubrutal-card p-6 aspect-square flex flex-col justify-between\" data-kid=\"17\">\n            <span class=\"font-heading font-bold text-lg uppercase\" data-kid=\"18\">Follow-ups Due</span>\n            <div class=\"text-7xl font-bold tracking-tighter\" data-kid=\"19\">05</div>\n          </div>\n        </section>\n\n        \n        <section class=\"flex flex-wrap gap-4 items-center\" data-kid=\"20\">\n          <button class=\"neubrutal-btn bg-[#2563EB] text-white gap-2\" data-kid=\"21\">\n            <i class=\"ti ti-users text-xl\" data-kid=\"22\"></i>\n            View my leads\n          </button>\n          <button class=\"neubrutal-btn gap-2\" data-kid=\"23\">\n            <i class=\"ti ti-phone-call text-xl\" data-kid=\"24\"></i>\n            My calls\n          </button>\n          <div class=\"flex-grow\" data-kid=\"25\"></div>\n          <div class=\"neubrutal-card px-4 py-2 flex items-center gap-3 bg-white\" data-kid=\"26\">\n            <span class=\"w-3 h-3 bg-green-500 rounded-full animate-pulse border border-black\" data-kid=\"27\"></span>\n            <span class=\"font-bold text-sm uppercase font-heading\" data-kid=\"28\">Live activity</span>\n          </div>\n        </section>\n\n        \n        <section class=\"space-y-4\" data-kid=\"29\">\n          <div class=\"flex items-center gap-3\" data-kid=\"30\">\n            <h2 class=\"font-heading text-3xl font-bold uppercase italic\" data-kid=\"31\">Hot Leads Ledger</h2>\n            <div class=\"h-1 flex-grow bg-black\" data-kid=\"32\"></div>\n          </div>\n          <div class=\"overflow-x-auto neubrutal-card\" data-kid=\"33\">\n            <table class=\"w-full neubrutal-table border-collapse\" data-kid=\"34\">\n              <thead data-kid=\"35\">\n                <tr data-kid=\"36\">\n                  <th data-kid=\"37\">Lead Name</th>\n                  <th data-kid=\"38\">Contact</th>\n                  <th data-kid=\"39\">Location</th>\n                  <th data-kid=\"40\">Status</th>\n                  <th data-kid=\"41\">Next Action</th>\n                </tr>\n              </thead>\n              <tbody data-kid=\"42\">\n                <tr data-kid=\"43\">\n                  <td class=\"font-bold\" data-kid=\"44\">Aravind Sharma</td>\n                  <td data-kid=\"45\">+91 98765 43210</td>\n                  <td data-kid=\"46\">Mumbai</td>\n                  <td data-kid=\"47\"><span class=\"bg-[#FF6B6B] text-white px-3 py-1 border border-black text-xs font-bold uppercase\" data-kid=\"48\">Hot</span></td>\n                  <td class=\"italic\" data-kid=\"49\">Call today 2:00 PM</td>\n                </tr>\n                <tr data-kid=\"50\">\n                  <td class=\"font-bold\" data-kid=\"51\">Priya Verma</td>\n                  <td data-kid=\"52\">+91 99887 76655</td>\n                  <td data-kid=\"53\">Delhi NCR</td>\n                  <td data-kid=\"54\"><span class=\"bg-[#FF6B6B] text-white px-3 py-1 border border-black text-xs font-bold uppercase\" data-kid=\"55\">Hot</span></td>\n                  <td class=\"italic\" data-kid=\"56\">Site visit tomorrow</td>\n                </tr>\n                <tr data-kid=\"57\">\n                  <td class=\"font-bold\" data-kid=\"58\">Rahul Mehra</td>\n                  <td data-kid=\"59\">+91 91234 56789</td>\n                  <td data-kid=\"60\">Bangalore</td>\n                  <td data-kid=\"61\"><span class=\"bg-[#FF6B6B] text-white px-3 py-1 border border-black text-xs font-bold uppercase\" data-kid=\"62\">Hot</span></td>\n                  <td class=\"italic\" data-kid=\"63\">Send proposal</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </section>\n\n        \n        <section class=\"space-y-6\" data-kid=\"64\">\n          <div class=\"flex items-center gap-3\" data-kid=\"65\">\n            <h2 class=\"font-heading text-3xl font-bold uppercase italic\" data-kid=\"66\">Activity Stream</h2>\n            <div class=\"h-1 flex-grow bg-black\" data-kid=\"67\"></div>\n          </div>\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-4\" data-kid=\"68\">\n            <div class=\"polaroid\" data-kid=\"69\">\n              <div class=\"bg-blue-100 aspect-video mb-4 flex items-center justify-center border border-black\" data-kid=\"70\">\n                <i class=\"ti ti-phone-call text-4xl\" data-kid=\"71\"></i>\n              </div>\n              <p class=\"font-bold mb-1\" data-kid=\"72\">Call with Sameer Roy</p>\n              <p class=\"text-sm text-neutral-600 mb-4 italic\" data-kid=\"73\">Lead showed interest in Skyview Apartments. Requested brochure via WhatsApp.</p>\n              <span class=\"text-xs font-heading font-bold uppercase text-neutral-400\" data-kid=\"74\">Today, 10:45 AM</span>\n            </div>\n            <div class=\"polaroid\" data-kid=\"75\">\n              <div class=\"bg-green-100 aspect-video mb-4 flex items-center justify-center border border-black\" data-kid=\"76\">\n                <i class=\"ti ti-check text-4xl\" data-kid=\"77\"></i>\n              </div>\n              <p class=\"font-bold mb-1\" data-kid=\"78\">Status Update: Anjali Singh</p>\n              <p class=\"text-sm text-neutral-600 mb-4 italic\" data-kid=\"79\">Changed from \"Initial Contact\" to \"Qualified Lead\" after verification call.</p>\n              <span class=\"text-xs font-heading font-bold uppercase text-neutral-400\" data-kid=\"80\">Today, 09:15 AM</span>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      \n      <aside class=\"lg:col-span-3 mt-12 lg:mt-0\" data-kid=\"81\">\n        <div class=\"sticky top-12 space-y-8\" data-kid=\"82\">\n          \n          <div class=\"sticky-note\" data-kid=\"83\">\n            <div class=\"flex items-center gap-2 mb-4\" data-kid=\"84\">\n              <i class=\"ti ti-bell-ringing text-2xl\" data-kid=\"85\"></i>\n              <h3 class=\"font-heading text-xl font-bold uppercase tracking-tight\" data-kid=\"86\">Reminders</h3>\n            </div>\n            <ul class=\"space-y-4\" data-kid=\"87\">\n              <li class=\"flex gap-3\" data-kid=\"88\">\n                <input type=\"checkbox\" class=\"w-5 h-5 border-2 border-black accent-black mt-1\" data-kid=\"89\">\n                <div data-kid=\"90\">\n                  <p class=\"font-bold leading-tight\" data-kid=\"91\">Follow up with Mehta family</p>\n                  <p class=\"text-xs font-medium uppercase mt-1\" data-kid=\"92\">Due in 2h</p>\n                </div>\n              </li>\n              <li class=\"flex gap-3\" data-kid=\"93\">\n                <input type=\"checkbox\" class=\"w-5 h-5 border-2 border-black accent-black mt-1\" data-kid=\"94\">\n                <div data-kid=\"95\">\n                  <p class=\"font-bold leading-tight\" data-kid=\"96\">Prepare listing for Oak Ridge</p>\n                  <p class=\"text-xs font-medium uppercase mt-1\" data-kid=\"97\">Due in 4h</p>\n                </div>\n              </li>\n              <li class=\"flex gap-3\" data-kid=\"98\">\n                <input type=\"checkbox\" class=\"w-5 h-5 border-2 border-black accent-black mt-1\" data-kid=\"99\">\n                <div data-kid=\"100\">\n                  <p class=\"font-bold leading-tight\" data-kid=\"101\">Review quarterly targets</p>\n                  <p class=\"text-xs font-medium uppercase mt-1\" data-kid=\"102\">Due tonight</p>\n                </div>\n              </li>\n            </ul>\n            <button class=\"w-full mt-6 neubrutal-btn bg-white py-2 text-sm uppercase\" data-kid=\"103\">Add Note</button>\n          </div>\n\n          \n          <div class=\"neubrutal-card p-6 bg-[#2563EB] text-white\" data-kid=\"104\">\n            <h4 class=\"font-heading font-bold uppercase mb-2\" data-kid=\"105\">Pro Tip</h4>\n            <p class=\"text-sm italic opacity-90\" data-kid=\"106\">\"The best time to call a lead is within 5 minutes of their inquiry. Strike while the iron is hot!\"</p>\n          </div>\n        </div>\n      </aside>\n    </div>\n  </div>\n</div>",
