{
  "name": "propninja-crm",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @propninja/db db:migrate",
    "db:seed": "pnpm --filter @propninja/db db:seed",
    "reset:admin": "pnpm --filter @propninja/db exec tsx ../../scripts/reset-admin.ts",
    "db:wipe": "pnpm --filter @propninja/db exec tsx ../../scripts/wipe-production-db.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "check:ci": "cross-env NEXT_PUBLIC_API_URL=https://api.ci.propninja.test turbo lint test build",
    "railway:build": "pnpm --filter @propninja/db build && pnpm --filter @propninja/api build",
    "railway:start": "pnpm db:migrate && pnpm --filter @propninja/api start",
    "mobile:eas:init": "pnpm --filter @propninja/mobile eas:init",
    "mobile:eas:android": "pnpm --filter @propninja/mobile eas:build:android",
    "mobile:eas:ios": "pnpm --filter @propninja/mobile eas:build:ios",
    "prepare": "node -e \"if (!process.env.CI && !process.env.VERCEL && !process.env.RAILWAY) require('child_process').execSync('husky', {stdio:'inherit'})\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
